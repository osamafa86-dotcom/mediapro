# Names only — real values live on the server (docs/deploy.md). Never commit a filled .env.
DATABASE_URL=postgres://media:media@localhost:5432/media
SESSION_SECRET=
LINK_SIGNING_SECRET=
APP_ORIGIN=https://media.emdatra.org
TZ=Asia/Hebron

# Staff magic-link mail. Unset in production = the message is dropped and a warning is logged (no link in logs).
SMTP_URL=
MAIL_FROM=EMDATRA <no-reply@emdatra.org>

# Cloudflare R2 (S3 API). Locally: MinIO from docker compose.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_PREFIX=media-library/
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_ORIGIN=

MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=

# Google Drive import (M6)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Phase 2 — single sign-on from wallt.emdatra.org (off until the parent site issues tokens)
EMDATRA_SSO_ENABLED=false
EMDATRA_SSO_SECRET=

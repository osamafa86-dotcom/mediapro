# /opt/sites/media/.env على الخادم (chmod 600). أسماء فقط هنا — القيم على الخادم وحده.
# تولّدها مهمة التركيب مرّة واحدة ولا تعيد توليدها: DB_PASSWORD وSESSION_SECRET وLINK_SIGNING_SECRET.
APP_ORIGIN=https://media.emdatra.org
DB_PASSWORD=
SESSION_SECRET=
LINK_SIGNING_SECRET=

# Cloudflare R2 — مفتاح API بصلاحية «Object Read & Write» على هذا الدلو وحده
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=media-library/

# البريد (روابط الدخول، التنبيهات، ردود الملاحظات). بلا قيمة: لا يُرسل شيء ويُسجَّل تحذير
SMTP_URL=smtps://user:pass@smtp.example.org:465
MAIL_FROM=EMDATRA <no-reply@emdatra.org>

# الاستيراد من Drive (اختياري) — docs/drive.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# الدخول الموحّد من الموقع الأم (المرحلة الثانية، مطفأ حتى يُصدر wallt الرموز) — docs/sso.md
EMDATRA_SSO_ENABLED=false
EMDATRA_SSO_SECRET=

{
  "appId": "org.emdatra.sakinah",
  "appName": "سكينة",
  "webDir": "www",
  "server": { "androidScheme": "https", "iosScheme": "https" },
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#0f766e",
    "limitsNavigationsToAppBoundDomains": false,
    "preferredContentMode": "mobile"
  },
  "plugins": {
    "SplashScreen": { "launchShowDuration": 0, "launchAutoHide": false, "backgroundColor": "#0f766e", "showSpinner": false, "splashFullScreen": true, "splashImmersive": true },
    "LocalNotifications": { "presentationOptions": ["badge", "alert"], "iconColor": "#0f766e" },
    "StatusBar": { "style": "LIGHT", "backgroundColor": "#0f766e" }
  }
}
